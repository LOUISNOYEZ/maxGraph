    "@storybook/html-vite": "~10.1.11",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "storybook": "~10.1.10",
    "vite": "~7.3.0",
    "vitest": "^4.1.0"
  }
}
