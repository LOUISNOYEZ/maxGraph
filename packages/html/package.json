  "private": true,
  "description": "Storybook stories",
  "type": "module",
  "imports": {
    "#stories": "./stories/*",
    "#*": [
      "./*",
      "./*.ts",
      "./*.tsx"
    ]
  },
  "scripts": {
    "dev": "storybook dev -p 8901",
